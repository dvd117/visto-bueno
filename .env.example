PORT=3000
NODE_ENV=production

# Traefik routing, read by docker-compose.yml (no defaults there on purpose).
# These are production's values. A preview (`/dokploy --preview`) sets
# ROUTER_ID=visto-bueno-dev, its own PUBLIC_HOST and ROBOTS_TAG=noindex, nofollow.
ROUTER_ID=visto-bueno
PUBLIC_HOST=visto-bueno.aragort.com
ROBOTS_TAG=
